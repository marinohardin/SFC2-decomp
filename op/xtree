					_W = _Right( _Parent( _X ) );
				}
				_Color( _W ) = _Color( _Parent( _X ) );
				_Color( _Parent( _X ) ) = _Black;
				_Color( _Right( _W ) ) = _Black;
				_Lrotate( _Parent( _X ) );
