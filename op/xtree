template<class _K, class _Ty, class _Kfn, class _Pr, class _A>
_Tree<_K, _Ty, _Kfn, _Pr, _A>::_Pairii _Tree<_K, _Ty, _Kfn, _Pr, _A>::equal_range( const _K& _Kv )
{
	_Nodeptr _X = _Root();
	_Nodeptr _U = _Head;
	while ( _X != _Nil )
		if ( key_compare( _Kv, _Key( _X ) ) )
			_U = _X, _X = _Left( _X );
		else
			_X = _Right( _X );
	_X = _Root();
	_Nodeptr _L = _Head;
	while ( _X != _Nil )
		if ( key_compare( _Key( _X ), _Kv ) )
			_X = _Right( _X );
		else
			_L = _X, _X = _Left( _X );
	return ( _Pairii( iterator( _L ), iterator( _U ) ) );
}

template<class _K, class _Ty, class _Kfn, class _Pr, class _A>
_Tree<_K, _Ty, _Kfn, _Pr, _A>::_Paircc _Tree<_K, _Ty, _Kfn, _Pr, _A>::equal_range( const _K& _Kv ) const
{
	return ( _Paircc( const_iterator( _Lbound( _Kv ) ), const_iterator( _Ubound( _Kv ) ) ) );
}

template<class _K, class _Ty, class _Kfn, class _Pr, class _A>
void _Tree<_K, _Ty, _Kfn, _Pr, _A>::const_iterator::_Dec()
	{
		if ( _Color( _Ptr ) == _Red && _Parent( _Parent( _Ptr ) ) == _Ptr )
			_Ptr = _Right( _Ptr );
		else if ( !_Isnil( _Left( _Ptr ) ) )
			_Ptr = _Max( _Left( _Ptr ) );
		else
		{
			_Nodeptr _P;
			while ( _Ptr == _Left( _P = _Parent( _Ptr ) ) )
				_Ptr = _P;
			_Ptr = _P;
		}
	}

template<class _K, class _Ty, class _Kfn, class _Pr, class _A>
void _Tree<_K, _Ty, _Kfn, _Pr, _A>::const_iterator::_Inc()
	{
		if ( _Isnil( _Right( _Ptr ) ) )
		{
			_Nodeptr _P;
