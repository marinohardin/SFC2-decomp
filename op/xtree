			_Root() = _Y;
		else if ( _Left( _Parent( _Z ) ) == _Z )
			_Left( _Parent( _Z ) ) = _Y;
		else
			_Right( _Parent( _Z ) ) = _Y;
		_Parent( _Y ) = _Parent( _Z );
		std::swap( _Color( _Y ), _Color( _Z ) );
		_Y = _Z;
	}
	else
	{
		_Parent( _X ) = _Parent( _Y );
		if ( _Root() == _Z )
			_Root() = _X;
		else if ( _Left( _Parent( _Z ) ) == _Z )
			_Left( _Parent( _Z ) ) = _X;
		else
			_Right( _Parent( _Z ) ) = _X;
		if ( _Lmost() != _Z )
			;
		else if ( _Right( _Z ) == _Nil )
			_Lmost() = _Parent( _Z );
		else
