{
 "hooks": {
  "PreToolUse": [
   {
    "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
    "hooks": [
     {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/harness/hooks/guard.py\""}
    ]
   }
  ],
  "Stop": [
   {
    "hooks": [
     {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/harness/hooks/stop_verify.py\"", "timeout": 900}
    ]
   }
  ]
 }
}
